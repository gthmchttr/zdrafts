{
  "name": "zdrafts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Edit a Zola site's pages in the browser, in the site's own look",
  "license": "EUPL-1.2",
  "scripts": {
    "setup": "node scripts/fetch-zola.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
